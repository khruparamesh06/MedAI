# ---------------------------------------------------------------------------
# MedAI configuration. Copy to ".env" (same folder) and edit.  NEVER commit .env.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# REQUIRED: long random secret used to sign login tokens. Generate one with:
#   backend\.venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Minutes before a login token expires
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database. Leave commented to use the local SQLite file backend/medai.db.
# PostgreSQL example (required in production):
# DATABASE_URL=postgresql+psycopg://medai:CHANGE_ME@localhost:5432/medai

# Comma-separated frontend origins allowed to call the API.
# Production: exact https:// origins only ('*' is refused at startup).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting of sign-in, registration, uploads and analysis (cannot be disabled in production)
RATE_LIMIT_ENABLED=true

# Swagger UI at /docs. Defaults to on in development and OFF in production.
# ENABLE_API_DOCS=false

# Behind a reverse proxy: the proxy address(es) whose X-Forwarded-For header uvicorn may trust.
# Never use * when the API port is reachable directly.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Private X-ray storage folder (relative paths are resolved from the MedAI folder)
UPLOAD_DIR=backend/storage/xrays
MAX_UPLOAD_MB=10

# Time zone for doctor availability and appointment times (IANA name)
CLINIC_TIMEZONE=Asia/Kolkata

# AI model configuration file (see ai/README.md)
MODEL_CONFIG_PATH=ai/model_config.json

# Only used by docker-compose.yml
# POSTGRES_PASSWORD=change-me
